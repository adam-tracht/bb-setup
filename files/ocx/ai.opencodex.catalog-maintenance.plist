<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.opencodex.catalog-maintenance</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>__HOME__/.opencodex/catalog-maintenance.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.opencodex/catalog-maintenance.error.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.opencodex/catalog-maintenance.log</string>
	<key>StartInterval</key>
	<integer>3600</integer>
</dict>
</plist>
